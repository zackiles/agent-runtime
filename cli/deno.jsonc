{
  "$schema": "https://raw.githubusercontent.com/denoland/deno/refs/heads/main/cli/schemas/config-file.v1.json",
  "name": "@ar/cli",
  "version": "0.0.2",
  "tasks": {
    "ar": "deno run -A src/cli.ts",
    "run:dev": "DENO_ENV=development deno run -A --watch --log-level=debug src/cli.ts",
    "run:dev:container": "deno run -A scripts/run-cursor-dev-container.ts",
    "run:docs": "deno run -A scripts/serve-docs.ts",
    "test": "DENO_ENV=test deno run -A scripts/test.ts",
    "check": "deno lint --fix && deno check -r src/",
    "tag": "deno run -A scripts/tag.ts",
    "build": "deno run -A scripts/build.ts",
    "build:hypermix": "deno run -A jsr:@zackiles/hypermix --config .ai/hypermix.config.ts",
    "build:docs": "deno doc --html --name=ar-cli --output=./docs/ar-cli src/**/*.ts"
  },
  "imports": {
    "@std/cli": "jsr:@std/cli@1",
    "@std/fs": "jsr:@std/fs@1",
    "@std/jsonc": "jsr:@std/jsonc@^1.0.2",
    "@std/path": "jsr:@std/path@1",
    "@std/fmt": "jsr:@std/fmt@1",
    "@std/streams": "jsr:@std/streams@1",
    "@std/semver": "jsr:@std/semver@1",
    "@std/http": "jsr:@std/http@1",
    "@std/net": "jsr:@std/net@1",
    "@std/assert": "jsr:@std/assert@1",
    "@std/tar": "jsr:@std/tar@^0.1.10"
  },
  "fmt": {
    "lineWidth": 80,
    "semiColons": false,
    "useTabs": false,
    "indentWidth": 2,
    "singleQuote": true,
    "proseWrap": "preserve",
    "include": ["src/**", "scripts/**", "test/**"],
    "exclude": ["bin/**", "test/mocks/**", "test/fixtures/**"]
  },
  "lint": {
    "rules": { "tags": ["recommended"] },
    "include": ["deno.jsonc", "src/**", "scripts/**", "test/**"],
    "exclude": ["bin/**", "test/mocks/**", "test/fixtures/**"]
  },
  "test": {
    "include": ["test/**/*.test.ts"]
  },
  "exports": {
    ".": "./src/cli.ts"
  },
  "compilerOptions": {
    "strict": true,
    "noErrorTruncation": true,
    "exactOptionalPropertyTypes": true,
    "lib": [
      "esnext",
      "deno.window",
      "deno.unstable",
      "deno.worker",
      "decorators"
    ]
  }
}
