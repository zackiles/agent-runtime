{
  // Secrets — copy this file to secrets.jsonc and fill in your values.
  //
  // This file holds secret values used when deploying from source locally.
  // Each key maps to a GCP Secret Manager secret that is wired into agent
  // functions and the control plane at deploy time.
  //
  // In CI, these values come from GitHub repository secrets or environment
  // variables instead. Production builds never embed secrets.
  //
  // Precedence (lowest to highest):
  //   1. This file (secrets.jsonc)
  //   2. Environment variables with the same name
  //   3. GCP Secret Manager (at runtime)

  // --- Subsystem API keys ---

  "CURSOR_API_KEY": "",
  "ANTHROPIC_API_KEY": "",

  // --- Source control ---

  "GH_TOKEN": "",

  // --- Observability ---

  "DD_API_KEY": "",
  "DD_APP_KEY": "",
  "DD_SITE": "datadoghq.com",

  // --- Identity ---

  "AUTH0_DOMAIN": "",
  "AUTH0_CLIENT_ID": "",
  "AUTH0_CLIENT_SECRET": "",

  // --- Atlassian / Jira ---

  "JIRA_SERVICE_ACCOUNT_EMAIL": "",
  "JIRA_SERVICE_KEY": "",

  // --- incident.io ---

  "INCIDENT_IO_API_KEY": "",

  // --- Control Plane ---
  // AR_SESSION_SECRET: HMAC key for session cookies (auto-generated if empty)
  // AR_ADMIN_GROUP: comma-separated admin emails
  // AR_ALLOWED_DOMAINS: comma-separated allowed email domains

  "AR_SESSION_SECRET": "",
  "AR_ADMIN_GROUP": "",
  "AR_ALLOWED_DOMAINS": "",

  // --- Google OAuth (web dashboard login) ---
  // Create at: https://console.cloud.google.com/apis/credentials
  // Type: Web application
  // Redirect URI: https://{cp-url}/web/auth/callback

  "GOOGLE_CLIENT_ID": "",
  "GOOGLE_CLIENT_SECRET": "",

  // --- Slack Bot ---
  // Create a Slack app at: https://api.slack.com/apps
  // See docs/slack-bot.md for setup instructions.
  //
  // Bot Token: OAuth & Permissions page (xoxb-...)
  // Signing Secret: Basic Information page
  // Client ID / Secret: Basic Information page
  // App Token (xapp-...): api.slack.com/apps → Basic Information → App-Level Tokens
  //   Requires scopes: authorizations:read, app_configurations:write, connections:write
  // Config Token (xoxe.xoxp-...): api.slack.com/apps → Your App Configuration Tokens
  //   Used by ar bot enable to push the app manifest. Expires in 12 hours but
  //   can be refreshed indefinitely via tooling.tokens.rotate using the refresh token.
  // Config Refresh Token (xoxe-...): returned alongside the config token.
  //   Store both — the CLI auto-refreshes before each manifest update.

  "SLACK_BOT_TOKEN": "",
  "SLACK_SIGNING_SECRET": "",
  "SLACK_CLIENT_ID": "",
  "SLACK_CLIENT_SECRET": "",
  "SLACK_APP_TOKEN": "",
  "SLACK_CONFIG_TOKEN": "",
  "SLACK_CONFIG_REFRESH_TOKEN": "",
  "SLACK_APP_ID": ""
}
