{
  "name": "@ar/client",
  "version": "0.0.1",
  "exports": {
    ".": "./src/mod.ts",
    "./platform": "./src/platform/mod.ts",
    "./db": "./src/db/mod.ts",
    "./db/agents": "./src/db/agents.ts",
    "./db/access": "./src/db/access.ts",
    "./db/audit": "./src/db/audit.ts",
    "./db/configs": "./src/db/configs.ts",
    "./db/copy": "./src/db/copy.ts",
    "./db/registry": "./src/db/registry.ts",
    "./db/schema": "./src/db/schema.ts",
    "./db/sync": "./src/db/sync.ts",
    "./db/teams": "./src/db/teams.ts",
    "./db/telemetry": "./src/db/telemetry.ts",
    "./db/tools": "./src/db/tools.ts",
    "./db/users": "./src/db/users.ts",
    "./db/slack": "./src/db/slack.ts",
    "./config": "./src/config.ts",
    "./mode": "./src/mode.ts",
    "./runtime": "./src/runtime.ts",
    "./build": "./src/build.ts",
    "./tenant": "./src/tenant.ts",
    "./types": "./src/types.ts",
    "./registry": "./src/registry.ts",
    "./tool-schema": "./src/tool-schema.ts",
    "./rule-schema": "./src/rule-schema.ts",
    "./skill-schema": "./src/skill-schema.ts",
    "./agent-schema": "./src/agent-schema.ts",
    "./subsystems": "./src/subsystems.ts",
    "./entity-schema": "./src/entity-schema.ts",
    "./templates": "./src/templates/mod.ts",
    "./defaults/tools": "./src/defaults/tools.ts",
    "./utils/logger": "./src/utils/logger.ts",
    "./utils/formatting": "./src/utils/formatting.ts",
    "./utils/graceful-shutdown": "./src/utils/graceful-shutdown.ts",
    "./operations/secrets": "./src/operations/secrets.ts",
    "./operations/runtime": "./src/operations/runtime.ts",
    "./operations/registry": "./src/operations/registry.ts",
    "./operations/demos": "./src/operations/demos.ts",
    "./incident-io": "./src/incident-io.ts"
  },
  "imports": {
    "@db/sqlite": "jsr:@db/sqlite@^0.13.0",
    "@hono/hono": "jsr:@hono/hono@^4.12.5",
    "@std/fmt": "jsr:@std/fmt@1",
    "@std/fs": "jsr:@std/fs@1",
    "@std/dotenv": "jsr:@std/dotenv@0",
    "@std/path": "jsr:@std/path@1",
    "@std/assert": "jsr:@std/assert@1",
    "@std/cli": "jsr:@std/cli@1",
    "@std/jsonc": "jsr:@std/jsonc@1",
    "@std/net": "jsr:@std/net@1",
    "@std/http": "jsr:@std/http@1",
    "@std/text": "jsr:@std/text@1",
    "@std/regexp": "jsr:@std/regexp@1",
    "@std/bytes": "jsr:@std/bytes@1",
    "@std/data-structures": "jsr:@std/data-structures@1",
    "@std/crypto": "jsr:@std/crypto@1",
    "@std/datetime": "jsr:@std/datetime@0",
    "@std/msgpack": "jsr:@std/msgpack@1",
    "@std/encoding": "jsr:@std/encoding@1",
    "@std/streams": "jsr:@std/streams@1",
    "@std/testing": "jsr:@std/testing@1",
    "@std/semver": "jsr:@std/semver@1",
    "@std/yaml": "jsr:@std/yaml@^1.0.12"
  },
  "compilerOptions": {
    "strict": true,
    "noErrorTruncation": true,
    "exactOptionalPropertyTypes": true,
    "lib": [
      "esnext",
      "deno.window",
      "deno.unstable",
      "deno.worker",
      "decorators"
    ]
  },
  "fmt": {
    "lineWidth": 80,
    "semiColons": false,
    "useTabs": false,
    "indentWidth": 2,
    "singleQuote": true,
    "proseWrap": "preserve",
    "include": ["src/**"]
  },
  "lint": {
    "rules": { "tags": ["recommended"] },
    "include": ["deno.jsonc", "src/**"]
  }
}
